---
import '../styles/global.css';
import { site } from '../site';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.tagline } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const path = Astro.url.pathname;
const nav = [
  { href: url('/'), label: 'Home' },
  { href: url('/projects/'), label: 'Projects' },
  { href: url('/cv/'), label: 'CV' },
];
const isActive = (href: string) =>
  href === url('/') ? path === href : path.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <script is:inline>
      // Apply the saved or system theme before paint to avoid a flash.
      const saved = localStorage.getItem('theme');
      const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.classList.toggle('dark', dark);
    </script>
  </head>
  <body class="min-h-screen">
    <header class="mx-auto flex max-w-3xl items-center justify-between px-5 py-6">
      <a href={url('/')} class="font-semibold tracking-tight no-underline">{site.name}</a>
      <nav class="flex items-center gap-5 text-sm">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                'no-underline hover:text-accent dark:hover:text-accent-dark',
                isActive(item.href) ? 'text-accent dark:text-accent-dark' : 'text-zinc-500 dark:text-zinc-400',
              ]}
            >
              {item.label}
            </a>
          ))
        }
        <button
          id="theme-toggle"
          type="button"
          aria-label="Toggle dark mode"
          class="rounded-md p-1.5 text-zinc-500 hover:bg-zinc-100 dark:text-zinc-400 dark:hover:bg-zinc-800"
        >
          <svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
          </svg>
          <svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
        </button>
      </nav>
    </header>

    <main class="mx-auto max-w-3xl px-5 pb-16">
      <slot />
    </main>

    <footer class="mx-auto max-w-3xl px-5 py-8 text-xs text-zinc-500 dark:text-zinc-500">
      © {new Date().getFullYear()} {site.name}
    </footer>

    <script>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      });
    </script>
  </body>
</html>
