---
import { getCollection, render } from 'astro:content';

const entries = (await getCollection('experience')).sort((a, b) => b.data.start.valueOf() - a.data.start.valueOf());
const rendered = await Promise.all(entries.map(async (e) => ({ e, Content: (await render(e)).Content })));
---

<ol class="space-y-8">
  {
    rendered.map(({ e, Content }) => (
      <li>
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h3 class="font-medium">{e.data.org}</h3>
          <span class="text-xs text-zinc-500">{e.data.period}</span>
        </div>
        <p class="text-sm text-zinc-600 italic dark:text-zinc-400">
          {e.data.role}
          {e.data.location && ` · ${e.data.location}`}
        </p>
        {e.data.note && <p class="text-xs text-zinc-500">{e.data.note}</p>}
        <div class="prose prose-sm prose-zinc mt-2 max-w-none dark:prose-invert prose-code:before:content-none prose-code:after:content-none">
          <Content />
        </div>
      </li>
    ))
  }
</ol>
