---
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/url';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { title, summary, period, context, award, tags, ongoing } = project.data;
---

<a
  href={url(`/projects/${project.id}/`)}
  class="group block rounded-xl border border-zinc-200 p-5 no-underline transition hover:border-accent dark:border-zinc-800 dark:hover:border-accent-dark"
>
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="font-medium group-hover:text-accent dark:group-hover:text-accent-dark">{title}</h3>
    <span class="text-xs text-zinc-500">{period}{ongoing && ' · ongoing'}</span>
  </div>
  {context && <p class="mt-1 text-xs text-zinc-500">{context}</p>}
  <p class="mt-3 text-sm text-zinc-600 dark:text-zinc-400">{summary}</p>
  {award && <p class="mt-3 text-xs font-medium text-amber-700 dark:text-amber-400">🏆 {award}</p>}
  {
    tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <li class="rounded-full bg-zinc-100 px-2 py-0.5 text-xs text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">{tag}</li>
        ))}
      </ul>
    )
  }
</a>
