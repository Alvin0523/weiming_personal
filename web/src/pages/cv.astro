---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Experience from '../components/Experience.astro';
import { site } from '../site';
import { url } from '../lib/url';

const achievements = [
  ['Champion', 'Singapore AUV Challenge 2025 (international)'],
  ['Top 8, Best New All-Rounder & City of Irvine Award', 'RoboNation RoboSub 2025 (international)'],
  ['Best Project Runner-Up', 'HKUST COMP4901D Embedded AI Systems, 2026'],
  ["NTU President's Research Scholar", 'URECA undergraduate research'],
  ['Finalist', 'HacX @ HTX 2025'],
  ['Finalist', 'NTU Escendo @ Garage EEE 2025'],
  ['Rank 9', 'Ocean Exploration Video Challenge, MATE ROV 2024 (international)'],
];
---

<Base title="CV" description="Experience, education and achievements.">
  <div class="flex flex-wrap items-baseline justify-between gap-4 pt-6">
    <h1 class="text-2xl font-semibold tracking-tight">Curriculum Vitae</h1>
    <div class="flex gap-3 text-sm">
      <a href={url(`/${site.resume.en}`)} class="text-accent dark:text-accent-dark">PDF (English)</a>
      <a href={url(`/${site.resume.zh}`)} class="text-accent dark:text-accent-dark">PDF (中文)</a>
    </div>
  </div>

  <Section title="Experience">
    <Experience />
  </Section>

  <Section title="Education">
    <div class="space-y-6 text-sm">
      <div>
        <div class="flex flex-wrap items-baseline justify-between gap-x-4">
          <h3 class="text-base font-medium">Nanyang Technological University (NTU), Singapore</h3>
          <span class="text-xs text-zinc-500">Aug 2023 – May 2027</span>
        </div>
        <p class="text-zinc-600 dark:text-zinc-400">
          B.Eng. (Hons) Computer Engineering, Second Major in Data Analytics · CGPA 4.25/5.00
        </p>
      </div>
      <div>
        <div class="flex flex-wrap items-baseline justify-between gap-x-4">
          <h3 class="text-base font-medium">Hong Kong University of Science and Technology (HKUST)</h3>
          <span class="text-xs text-zinc-500">Jan 2026 – May 2026</span>
        </div>
        <p class="text-zinc-600 dark:text-zinc-400">
          Semester exchange · Intelligent Robot & Embodied AI, Machine Learning, Deep Learning in Computer Vision,
          Embedded AI Systems, Deep 2D & 3D Visual Scene Understanding, Aerial Robotics
        </p>
      </div>
    </div>
  </Section>

  <Section title="Achievements">
    <ul class="space-y-2 text-sm">
      {
        achievements.map(([title, detail]) => (
          <li>
            <span class="font-medium">{title}</span>
            <span class="text-zinc-500"> — {detail}</span>
          </li>
        ))
      }
    </ul>
  </Section>
</Base>
